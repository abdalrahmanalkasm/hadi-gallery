---
import '../styles/global.css';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';

const { title, description } = Astro.props;
const a = site.artist;
const pageTitle = title ? `${title} — ${a.name}` : `${a.name} — ${site.siteName}`;
const desc = description ?? `${a.discipline} in ${a.location}. ${a.heroLine}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <script is:inline>
    // Reveal-on-scroll is progressive enhancement. Content is visible by
    // default; only add the class that hides it once we know JS runs, and
    // only if the browser supports the observer we need.
    if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main"><slot /></main>

  <dialog class="lb" aria-label="Full size view">
    <div class="lb-scroll"><div class="lb-canvas"><img alt="" /></div></div>
    <div class="lb-bar">
      <p class="lb-cap data t-small"></p>
      <button class="lb-close data t-small" type="button">Close</button>
    </div>
  </dialog>

  <script>
    const nav = document.querySelector('.nav');
    const btn = document.querySelector('.nav-btn');
    btn?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Close' : 'Menu';
    });
    document.querySelectorAll('.nav-list a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        if (btn) btn.textContent = 'Menu';
      })
    );

    const items = document.querySelectorAll('.rv');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
      items.forEach((el) => io.observe(el));
    }

    // Full-size view. The <dialog> supplies Esc, the focus trap, and returning
    // focus to the button that opened it. Zoom scales the image inside a
    // scrolling box, so panning is the browser's own scrolling and a phone's
    // pinch still works untouched.
    const lb = document.querySelector('.lb');
    if (lb) {
      const scroll = lb.querySelector('.lb-scroll');
      const lbImg = scroll.querySelector('img');
      const cap = lb.querySelector('.lb-cap');

      // 1 is the fitted size. The ceiling is one screen pixel per image pixel —
      // past that the photograph has no more detail to give, only blur.
      let zoom = 1, fitW = 0, maxZoom = 1;

      function measure() {
        if (fitW) return;
        fitW = lbImg.getBoundingClientRect().width;
        maxZoom = fitW ? Math.max(1, lbImg.naturalWidth / fitW) : 1;
      }

      // Anchored so whatever sits under the pointer stays under it. Without
      // this the reader loses the spot they were looking at on every notch.
      function setZoom(next, x, y) {
        measure();
        next = Math.min(maxZoom, Math.max(1, next));
        if (next === zoom) return;

        const box = scroll.getBoundingClientRect();
        if (x == null) { x = box.left + box.width / 2; y = box.top + box.height / 2; }
        const was = lbImg.getBoundingClientRect();
        const fx = was.width ? Math.min(1, Math.max(0, (x - was.left) / was.width)) : 0.5;
        const fy = was.height ? Math.min(1, Math.max(0, (y - was.top) / was.height)) : 0.5;

        zoom = next;
        lb.classList.toggle('zoomed', zoom > 1);
        lbImg.style.width = zoom > 1 ? `${fitW * zoom}px` : '';

        const now = lbImg.getBoundingClientRect();
        scroll.scrollLeft += now.left + fx * now.width - x;
        scroll.scrollTop += now.top + fy * now.height - y;
      }

      document.querySelectorAll('.zoomable').forEach((btn) => {
        btn.addEventListener('click', () => {
          const img = btn.querySelector('img');
          zoom = 1; fitW = 0;
          lb.classList.remove('zoomed');
          lbImg.style.width = '';
          lbImg.src = img.currentSrc || img.src;
          lbImg.alt = img.alt;
          cap.textContent = img.alt;
          lb.showModal();
        });
      });

      // deltaY is reported in pixels, lines or pages depending on the device;
      // normalise so a trackpad glides and a notched wheel steps about 10%.
      scroll.addEventListener('wheel', (e) => {
        e.preventDefault();
        const px = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
        setZoom(zoom * Math.pow(0.999, px), e.clientX, e.clientY);
      }, { passive: false });

      // Drag to pan, mouse only — a touch screen already pans and pinches by
      // itself and hijacking that would make it worse. A press that travels
      // more than a few pixels is a drag; anything shorter stays a click, so
      // the same button can both pan and toggle the zoom.
      let panning = false, dragged = false, fromX = 0, fromY = 0, fromL = 0, fromT = 0;

      scroll.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0 || zoom <= 1) return;
        panning = true; dragged = false;
        fromX = e.clientX; fromY = e.clientY;
        fromL = scroll.scrollLeft; fromT = scroll.scrollTop;
        scroll.setPointerCapture(e.pointerId);
        lb.classList.add('panning');
        e.preventDefault();
      });

      scroll.addEventListener('pointermove', (e) => {
        if (!panning) return;
        const dx = e.clientX - fromX, dy = e.clientY - fromY;
        if (!dragged && Math.hypot(dx, dy) > 4) dragged = true;
        scroll.scrollLeft = fromL - dx;
        scroll.scrollTop = fromT - dy;
      });

      const endPan = (e) => {
        if (!panning) return;
        panning = false;
        lb.classList.remove('panning');
        try { scroll.releasePointerCapture(e.pointerId); } catch {}
      };
      scroll.addEventListener('pointerup', endPan);
      scroll.addEventListener('pointercancel', endPan);

      lbImg.addEventListener('click', (e) => {
        if (dragged) { dragged = false; return; }
        measure();
        setZoom(zoom > 1 ? 1 : maxZoom, e.clientX, e.clientY);
      });

      // The wheel is no use to anyone working from the keyboard.
      lb.addEventListener('keydown', (e) => {
        if (e.key === '+' || e.key === '=') { e.preventDefault(); setZoom(zoom * 1.25); }
        else if (e.key === '-') { e.preventDefault(); setZoom(zoom / 1.25); }
        else if (e.key === '0') { e.preventDefault(); setZoom(1); }
      });

      // A resize changes what "fitted" means, so the baseline has to go.
      addEventListener('resize', () => { fitW = 0; setZoom(1); });

      // The padding around the image is the only safe place to click away —
      // and only if the press was a click, not a pan that overshot the edge.
      // e.target is .lb-scroll or .lb-canvas, its sizing wrapper, never the
      // image itself, which is what keeps a click on the image from closing.
      scroll.addEventListener('click', (e) => {
        if (dragged) { dragged = false; return; }
        if (e.target !== lbImg) lb.close();
      });
      lb.querySelector('.lb-close').addEventListener('click', () => lb.close());
      lb.addEventListener('close', () => {
        zoom = 1; fitW = 0;
        lb.classList.remove('zoomed');
        lbImg.style.width = '';
        lbImg.removeAttribute('src');
      });
    }

    document.querySelectorAll('.exh-head').forEach((head) => {
      head.addEventListener('click', () => {
        const item = head.closest('.exh-item');
        const wasOpen = item.classList.contains('open');
        document.querySelectorAll('.exh-item.open').forEach((i) => {
          i.classList.remove('open');
          i.querySelector('.exh-head')?.setAttribute('aria-expanded', 'false');
        });
        if (!wasOpen) { item.classList.add('open'); head.setAttribute('aria-expanded', 'true'); }
      });
    });
  </script>
</body>
</html>
