---
/**
 * One work: the plate and its museum label, laid out by `.work-scaled`.
 *
 * `headingLevel` exists because this component sits at two different depths.
 * On the front page each section has an h2, so a work title is an h3. On a
 * section's own page that section heading is the h1, so a work title must be
 * an h2 — hard-coding h3 there skipped a level, and skipped levels are how a
 * screen reader user loses the shape of a page they navigate by headings.
 */
const { work, eager = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
---
<article class="work rv">
  <a class="work-scaled" href={`/works/${work.slug}/`}>
    <span class="work-frame">
      <img
        src={`/images/${work.image}`}
        alt={`${work.title}, ${work.year}`}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    </span>
    <div class="work-label">
      <Heading class="t-title">{work.title}</Heading>
      <p class="t-small quiet work-line">
        {work.medium}, {work.dimensions}<br />
        {work.year}{work.edition ? `, ${work.edition}` : ''}
      </p>
      {/* Status and price live on the work's own page. Here the line stays a
          plate code, so the column reads as a body of work rather than a
          price list. */}
      <p class="data work-line"><span class="quiet">{work.code}</span></p>
      {work.details.length > 0 && (
        <span class="work-more data accent">
          {work.details.length} {work.details.length === 1 ? 'detail' : 'details'}
        </span>
      )}
    </div>
  </a>
</article>
